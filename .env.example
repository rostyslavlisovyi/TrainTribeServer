# Server configuration
SERVER_PORT=4111
APP_URL=http://localhost:4200

# OAuth configuration
OAUTH_AUDIENCE=traintribe-development
OAUTH_DOMAIN=https://securetoken.google.com/traintribe-development


# MongoDB configuration
MONGODB_URI=

# cloudinary configuration
CLOUDINARY_API_SECRET=
CLOUDINARY_API_KEY=
CLOUDINARY_CLOUD_NAME=traintribe
CLOUDINARY_BASE_FOLDER_UPLOAD=traintribe-dev


CRON_SECRET=
# Set to true to fetch city data and populate the database on startup
FETCH_CITY_ON_STARTUP=false

# firebase
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=


# sentry
SENTRY_DSN=

# Email configuration (Feedback)
GMAIL_USER=traintribeapp@gmail.com
GMAIL_PASSWORD=
FEEDBACK_RECIPIENT_EMAIL=